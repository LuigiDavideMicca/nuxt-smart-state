{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "#app": ["./node_modules/nuxt/dist/app"]
    }
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
